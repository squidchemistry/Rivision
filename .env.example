# ================== DATABASE (PostgreSQL) ==================
# Local: run `npm run db:dev` and paste the TCP URL it prints (postgres://...localhost:<port>/template1?sslmode=disable).
# Production: a pooled URL for the app (DATABASE_URL) and a direct URL for migrations (DIRECT_URL),
# e.g. from Prisma Postgres, Neon or Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ================== AUTH ==================
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32   (required in production)
NEXTAUTH_SECRET=""

# ================== AI ==================
# https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"
# Optional: preferred model (falls back to openai/gpt-oss-120b, then qwen/qwen3.8-27b)
# GROQ_MODEL="openai/gpt-oss-120b"

# "groq" calls Groq; "mock" is an offline, deterministic stand-in (tests, demos). Default: groq when GROQ_API_KEY is set, else mock.
# LLM_PROVIDER="mock"
# Comma-separated models to try in order (GROQ_MODEL is tried first)
# GROQ_MODELS="openai/gpt-oss-120b,qwen/qwen3.8-27b"

# ================== DEMO ==================
# DEMO_MODE=true shows a banner and always uses the mock AI. Load the demo accounts with `npm run db:seed-demo`.
# DEMO_MODE="true"
# Used by the Docker image: seed the demo accounts on every start
# DEMO_SEED="true"
# Optional: override the demo accounts' passwords (see DEMO.md for the defaults)
# DEMO_PASSWORD=""

# ================== BUSINESS ==================
# Calendar days (streaks) and months (plan limits) roll over at midnight in this timezone
APP_TIMEZONE="Asia/Kolkata"

# Shown on the payment page. Leave blank to hide payment instructions.
NEXT_PUBLIC_PAYMENT_UPI_ID=""
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME=""
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=""
NEXT_PUBLIC_PAYMENT_IFSC=""

# ================== SCRIPTS ==================
# Used only by `npm run admin:create` to create or reset the admin account.
# Remove ADMIN_PASSWORD from .env after running the script.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD=""

# Used only by `npm run db:seed`: the account that receives the sample DSA topics
SEED_USER_EMAIL=""
