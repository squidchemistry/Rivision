{
  "name": "rivision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:dev": "prisma dev --name rivision-db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types scripts/seed-dsa.ts",
    "admin:create": "node scripts/generate-admin.js",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "test": "vitest run",
    "test:db": "cross-env TEST_DB=1 vitest run",
    "test:e2e": "playwright test",
    "db:seed-demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "demo": "cross-env DEMO_MODE=true LLM_PROVIDER=mock next dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "framer-motion": "^12.34.3",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
